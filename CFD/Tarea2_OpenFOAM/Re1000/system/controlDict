FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         400;

deltaT          0.005;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       0.05;

writeControl    adjustableRunTime;

writeInterval   2;

purgeWrite      0;

writeFormat     binary;

writePrecision  10;

runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ( "libforces.so" );
        patches         ( cylinder );
        rho             rhoInf;
        rhoInf          1;
        CofR            ( 6 10 1.05 );
        liftDir         ( 0 1 0 );
        dragDir         ( 1 0 0 );
        pitchAxis       ( 0 0 1 );
        magUInf         1;
        lRef            2;
        Aref            0.2;
        writeControl    timeStep;
        writeInterval   1;
    }
}


